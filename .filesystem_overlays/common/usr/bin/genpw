#!/bin/python

import random
import string
import sys

res = ''
length = int(sys.argv[1]) if len(sys.argv) >= 2 else 12
# charset = string.printable[:-5].replace('`', '').replace('^', '').replace('|', '')
charset = string.ascii_letters + string.digits

while len(res) < length:
	res += random.choice(charset)

print(res)
